{
  "schemaVersion": "workshop.app.v1",
  "slug": "job-agent",
  "title": "Job Agent",
  "description": "Finds jobs in any field, tailors resumes, applies after you approve, and has an assistant chat.",
  "runtime": {
    "languages": [
      "python312"
    ],
    "profile": "browser",
    "build": [
      "python3.12",
      "scripts/hosted_build.py"
    ],
    "start": [
      "python3.12",
      "-m",
      "job_agent.hosted"
    ],
    "port": 8080,
    "healthPath": "/healthz"
  },
  "instructions": "Upload your resume, describe the jobs you want, then approve each application. Or just ask the assistant.",
  "inference": {
    "mode": "selectable",
    "models": [
      "deepseek/deepseek-v4.1-flash",
      "openai/gpt-6-luna",
      "z-ai/glm-5.3-flash"
    ],
    "defaultModel": "deepseek/deepseek-v4.1-flash",
    "defaultProfile": "deepseek-auto",
    "estimatedUsdPerVisit": {
      "low": 0,
      "high": 0.1
    },
    "estimateBasis": "Illustrative; portal limits apply."
  },
  "network": {
    "classServices": [],
    "publicHttpsDomains": [],
    "publicWeb": true
  },
  "storage": {
    "visitorMiB": 0,
    "schema": "chat.v1"
  },
  "integrations": []
}
