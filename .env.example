# Copy to .env and fill privately.
# How to reach Claude: auto (Claude Code if installed, else an API key), claude-code, anthropic, or off.
MODEL_BACKEND=auto
# Optional model name or alias (opus, sonnet, claude-opus-5-5...). Empty: the backend's default.
CLAUDE_MODEL=
# Only for MODEL_BACKEND=anthropic (or auto without Claude Code). Or use `ant auth login`.
ANTHROPIC_API_KEY=
# review = you approve every final submit (default). auto = submit without asking.
SUBMIT_MODE=review
# Hard cap on submitted applications per calendar day, across all sites.
DAILY_SUBMIT_LIMIT=15
# Optional: chrome (your installed Google Chrome) or chromium (Playwright's build).
BROWSER_CHANNEL=chrome
# Per-company default cap: at most COMPANY_CAP applications per COMPANY_WINDOW_DAYS (rolling).
COMPANY_CAP=3
COMPANY_WINDOW_DAYS=30
# Jobs scoring below this (0-100) are not prepared.
FIT_THRESHOLD=60
# With an API key: stop a run once model spending reaches this many US dollars.
SPEND_CAP_USD=1.00
# Cover letters: required (only when the form requires one), always, or never.
COVER_LETTER=required
# Company research for cover letters and "why us" answers: auto or off.
RESEARCH=auto
# Optional: a Brave Search API key makes research reliable (otherwise a free search is tried).
BRAVE_API_KEY=
