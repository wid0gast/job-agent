# Copy to .env and fill privately. Use a spending-capped key.
OPENROUTER_API_KEY=
# An explicit tool-capable OpenRouter model ID with a large context window.
# Several, comma-separated, are tried in order (useful for rate-limited free models).
OPENROUTER_MODEL=
# Hard cap on submitted applications per calendar day, across all sites.
DAILY_SUBMIT_LIMIT=15
# Optional: chrome (your installed Google Chrome) or chromium (Playwright's build).
BROWSER_CHANNEL=chrome
# Per-company default cap: at most COMPANY_CAP applications per COMPANY_WINDOW_DAYS (rolling).
COMPANY_CAP=3
COMPANY_WINDOW_DAYS=30
# Jobs scoring below this (0-100) are not prepared.
FIT_THRESHOLD=60
# Stop a run once model spending reaches this many US dollars.
SPEND_CAP_USD=1.00
# deny = skip model providers that store or train on your data. Some free models need allow.
OPENROUTER_DATA_COLLECTION=deny
# Cover letters: always (whenever the form has a place for one), required (only when it's required),
# or never. The Search page's choice overrides this.
COVER_LETTER=always
# Company research for cover letters and "why us" answers: auto or off.
RESEARCH=auto
# Emails to people at companies per day (you send each one from your own email).
DAILY_OUTREACH_LIMIT=10
# Optional: a Brave Search API key for web search (otherwise a free search is tried, best effort).
BRAVE_API_KEY=
